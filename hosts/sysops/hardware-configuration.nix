  };

  boot.initrd.luks.devices."cryptroot".device = "/dev/disk/by-uuid/30abe3f0-90bc-4389-b521-17bdcef848e5";

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/8F21-DBC5";
